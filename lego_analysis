import pandas as pd

# 1. Cargar el Dataset
df = pd.read_csv('lego_sets.csv')

print("--- DATOS DE LEGO CARGADOS CORRECTAMENTE ---")
#print(df.head())

# Variables del dataset como referencia: set_id,name,year,theme,subtheme,
# themeGroup,category,pieces,minifigs,agerange_min,US_retailPrice,
# bricksetURL,thumbnailURL,imageURL

# RETO 1: Filtrar el dataset para encontrar cuáles son los top 5 sets con 
# mayor cantidad de piezas (pieces) en toda la historia.
 
most_pieces = df[['name', 'pieces']].sort_values(by='pieces', ascending=False).head(5)
print("--- TOP 5 SETS CON MAYOR CANTIDAD DE PIEZAS ---")
print(most_pieces)

# RETO 2: Crear una nueva columna llamada price_per_piece dividiendo el precio en 
# EE.UU. (US_retailPrice) entre la cantidad de piezas (pieces).

df_without_na = df.dropna(subset=['US_retailPrice', 'pieces']).copy()

# Opcional pro: filtramos piezas mayores a 0 para evitar divisiones infinitas
df_without_na = df_without_na[df_without_na['pieces'] > 0]

df_without_na['price_per_piece'] = df_without_na['US_retailPrice'] / df_without_na['pieces']
print("--- COLUMNA PRICE PER PIECE CREADA ---")

top_expensive_per_piece = df_without_na[
['name', 'US_retailPrice', 'pieces', 'price_per_piece']
].sort_values(by='price_per_piece', ascending=False)

print('--- TOP 5 SETS MÁS CAROS POR CADA PIEZA ---')
print(top_expensive_per_piece.head(5))

# RETO 3: Agrupar los datos por la columna theme para descubrir cuáles son los 5 temas 
# de LEGO que más cantidad de sets han lanzado en total a lo largo de los años.

df_grouped = df_without_na.groupby('theme').size().reset_index(name='total_sets')
top_themes = df_grouped.sort_values(by='total_sets', ascending=False).head(5)
print("--- TOP 5 TEMAS DE LEGO CON MÁS SETS LANZADOS ---")
print(top_themes)

